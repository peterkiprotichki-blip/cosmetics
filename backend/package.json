{
  "name": "cosmetic-ims-backend",
  "version": "1.0.0",
  "description": "NestJS REST API for the Cosmetic Inventory Management System (Victory Cosmetics)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "seed": "node dist/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  }
}
