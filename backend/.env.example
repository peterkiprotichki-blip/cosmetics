# MongoDB connection string.
# The database must run as a single-node replica set because sales and
# purchases are saved inside transactions, e.g.:
#   mongodb://127.0.0.1:27017/cosmetic_ims?replicaSet=rs0
# Leave this line commented out (or delete the file) to let the application
# start an embedded development database in ./data/db instead.
# MONGO_URI=mongodb://127.0.0.1:27017/cosmetic_ims?replicaSet=rs0

# Secret used to sign JSON Web Tokens. Change it before going live.
JWT_SECRET=change-this-secret-to-something-long-and-random

# Port of the web server (default 3000).
PORT=3000
